def cmd_remap(driver: SkillkorpK20Driver, args):
    key = args.key
    action = args.action
    fn_mode = getattr(args, "fn", False)

    try:
        if fn_mode:
            success = driver.remap_fn_key(key, action)
            type_str = "Fn + "
        else:
            success = driver.remap_key(key, action)
            type_str = ""

        if success:
            act_name = REMAP_ACTIONS.get(action, (action, []))[0]
            print(f"\033[92mTouche {type_str}'{key}' remappée vers '{act_name}'.\033[0m")
        else:
            print("\033[91mÉchec du remappage de la touche.\033[0m", file=sys.stderr)
            sys.exit(1)
    except ValueError as e:
        print(f"\033[91mErreur: {e}\033[0m", file=sys.stderr)
        sys.exit(1)


def cmd_reset(driver: SkillkorpK20Driver, args):
    if not args.force:
        confirm = input("Êtes-vous sûr de vouloir réinitialiser le clavier aux réglages d'usine ? (o/N) ")
        if confirm.lower() not in ("o", "oui", "y", "yes"):
            print("Opération annulée.")
            return

    success = driver.factory_reset()
    if success:
        print("\033[92mClavier réinitialisé aux réglages d'usine avec succès.\033[0m")
    else:
        print("\033[91mÉchec de la réinitialisation d'usine.\033[0m", file=sys.stderr)
        sys.exit(1)


def cmd_profile(driver: SkillkorpK20Driver, args):
    pm = ProfileManager()
    action = args.action

    if action == "list":
        profiles = pm.list_profiles()
        if getattr(args, "json", False):
            print(json.dumps(profiles, indent=2, ensure_ascii=False))
            return

        print("Profils disponibles :")
        for p in profiles:
            star = "\033[92m* \033[0m" if p.get("active") else "  "
            print(f"{star}\033[1m{p['id']:10s}\033[0m - {p.get('name', p['id'])}")
            if p.get("description"):
                print(f"     {p['description']}")
            apps = p.get("auto_switch_apps", [])
            if apps:
                print(f"     Applications: {', '.join(apps)}")

    elif action == "get":
        prof_id = args.profile_id or pm.get_active_profile_id()
        p = pm.get_profile(prof_id)
        if not p:
            print(f"\033[91mProfil '{prof_id}' introuvable.\033[0m", file=sys.stderr)
            sys.exit(1)
        print(json.dumps(p, indent=2, ensure_ascii=False))

    elif action == "set":
        prof_id = args.profile_id
        try:
            p = pm.switch_profile(prof_id, driver=driver)
            print(f"\033[92mProfil actif : {p.get('name', prof_id)} ({prof_id})\033[0m")
        except ValueError as e:
            print(f"\033[91mErreur: {e}\033[0m", file=sys.stderr)
            sys.exit(1)

    elif action == "new":
        prof_id = args.profile_id
        name = args.name or prof_id
        copy_from = args.copy_from
        p = pm.create_profile(prof_id, name, copy_from)
        print(f"\033[92mProfil '{prof_id}' créé avec succès.\033[0m")

    elif action == "delete":
        prof_id = args.profile_id
        try:
            pm.delete_profile(prof_id)
            print(f"\033[92mProfil '{prof_id}' supprimé avec succès.\033[0m")
        except ValueError as e:
            print(f"\033[91mErreur: {e}\033[0m", file=sys.stderr)
            sys.exit(1)

    elif action == "export":
        prof_id = args.profile_id
        target = args.file
        try:
            pm.export_profile(prof_id, target)
            print(f"\033[92mProfil '{prof_id}' exporté vers {target}.\033[0m")
        except ValueError as e:
            print(f"\033[91mErreur: {e}\033[0m", file=sys.stderr)
            sys.exit(1)

    elif action == "import":
        source = args.file
        new_id = args.profile_id
        try:
            safe_id = pm.import_profile(source, new_id)
            print(f"\033[92mProfil importé sous l'identifiant '{safe_id}'.\033[0m")
        except Exception as e:
            print(f"\033[91mErreur lors de l'import: {e}\033[0m", file=sys.stderr)
            sys.exit(1)


def cmd_daemon(driver: SkillkorpK20Driver, args):
    """Run the profile auto-switch daemon monitoring active window."""
    pm = ProfileManager()
    print("Démarrage du démon de bascule automatique de profils SkillKorp K20...")
    last_class = None
    running = True

    def sig_handler(signum, frame):
        nonlocal running
        running = False
        print("\nArrêt du démon.")

    signal.signal(signal.SIGINT, sig_handler)
    signal.signal(signal.SIGTERM, sig_handler)

    while running:
        if pm.is_auto_switch_enabled():
            cls = detect_active_window_class()
            if cls and cls != last_class:
                last_class = cls
                # Check profiles matching this app
                profiles = pm.list_profiles()
                matched_prof = None
                for p in profiles:
                    for app in p.get("auto_switch_apps", []):
                        if app.lower() in cls:
                            matched_prof = p["id"]
                            break
                    if matched_prof:
                        break

                if matched_prof and matched_prof != pm.get_active_profile_id():
                    print(f"Application active: {cls} -> Bascule vers le profil '{matched_prof}'")
                    pm.switch_profile(matched_prof, driver=driver)

        time.sleep(1.0)


def main():
    common_parser = argparse.ArgumentParser(add_help=False)
    common_parser.add_argument("--json", action="store_true", help="Sortie au format JSON pour scripts")

    parser = argparse.ArgumentParser(
        prog="k20ctl",
        description="Utilitaire de configuration en ligne de commande pour le clavier gaming SkillKorp K20 Ultimate.",
        parents=[common_parser],
    )
    parser.add_argument("-d", "--device", help="Chemin du nœud de périphérique hidraw spécifique")

    subparsers = parser.add_subparsers(dest="command", help="Commandes disponibles")

    # status
    p_status = subparsers.add_parser("status", parents=[common_parser], help="Afficher l'état complet du clavier")

    # battery
    p_battery = subparsers.add_parser("battery", parents=[common_parser], help="Afficher l'état et le pourcentage de batterie")

    # rgb
    p_rgb = subparsers.add_parser("rgb", parents=[common_parser], help="Configurer l'éclairage RGB des touches")
    p_rgb.add_argument("--mode", choices=[k for k, _, _ in LIGHT_MODES], help="Effet RGB")
    p_rgb.add_argument("--speed", type=int, choices=range(1, 6), help="Vitesse (1 à 5)")
    p_rgb.add_argument("--brightness", type=int, choices=range(0, 5), help="Luminosité (0 à 4)")
    p_rgb.add_argument("--direction", type=int, choices=[0, 1], help="Direction (0=Droite, 1=Gauche)")
    p_rgb.add_argument("--color", help="Couleur hexadécimale (ex: '#FF0000')")

    # side-rgb
    p_srgb = subparsers.add_parser("side-rgb", parents=[common_parser], help="Configurer les bandes LED latérales")
    p_srgb.add_argument("--mode", choices=[k for k, _, _ in SIDE_LIGHT_MODES], help="Effet latéral")
    p_srgb.add_argument("--speed", type=int, choices=range(1, 6), help="Vitesse (1 à 5)")
    p_srgb.add_argument("--brightness", type=int, choices=range(0, 5), help="Luminosité (0 à 4)")
    p_srgb.add_argument("--color", help="Couleur hexadécimale")

    # polling-rate
    p_poll = subparsers.add_parser("polling-rate", parents=[common_parser], help="Configurer le taux de rafraîchissement")
    p_poll.add_argument("rate", type=int, choices=[125, 250, 500, 1000], help="Fréquence en Hz")

    # debounce
    p_deb = subparsers.add_parser("debounce", parents=[common_parser], help="Configurer le temps d'anti-rebond")
    p_deb.add_argument("ms", type=int, choices=range(2, 21), help="Temps en ms (2 à 20)")

    # sleep
    p_sleep = subparsers.add_parser("sleep", parents=[common_parser], help="Configurer les délais de mise en veille")
    p_sleep.add_argument("--light", type=int, help="Veille légère en secondes")
    p_sleep.add_argument("--deep", type=int, help="Veille profonde en secondes")

    # win-lock
    p_win = subparsers.add_parser("win-lock", parents=[common_parser], help="Verrouiller/déverrouiller la touche Windows")
    p_win.add_argument("state", choices=["on", "off", "toggle"], help="État du verrouillage")

    # wasd-swap
    p_wasd = subparsers.add_parser("wasd-swap", parents=[common_parser], help="Inverser les touches ZQSD et les flèches")
    p_wasd.add_argument("state", choices=["on", "off", "toggle"], help="État de l'inversion")

    # os-mode
    p_os = subparsers.add_parser("os-mode", parents=[common_parser], help="Configurer le mode de compatibilité système")
    p_os.add_argument("mode", choices=["win", "mac", "ios", "android"], help="Système d'exploitation")

    # gaming-mode
    p_game = subparsers.add_parser("gaming-mode", parents=[common_parser], help="Activer ou désactiver le mode Gaming")
    p_game.add_argument("state", choices=["on", "off"], help="État du mode Gaming")

    # remap
    p_remap = subparsers.add_parser("remap", parents=[common_parser], help="Remapper une touche standard ou Fn")
    p_remap.add_argument("key", help="Nom de la touche (ex: F1, A, Esc)")
    p_remap.add_argument("action", choices=list(REMAP_ACTIONS.keys()), help="Action assignée")
    p_remap.add_argument("--fn", action="store_true", help="Remapper la combinaison Fn + touche")

    # reset
    p_reset = subparsers.add_parser("reset", parents=[common_parser], help="Réinitialiser le clavier aux réglages d'usine")
    p_reset.add_argument("-f", "--force", action="store_true", help="Ne pas demander confirmation")

    # profile
    p_prof = subparsers.add_parser("profile", parents=[common_parser], help="Gestion des profils de configuration")
    p_prof.add_argument("action", choices=["list", "get", "set", "new", "delete", "export", "import"])
    p_prof.add_argument("profile_id", nargs="?", help="Identifiant du profil")
    p_prof.add_argument("--name", help="Nom lisible du profil (pour 'new')")
    p_prof.add_argument("--copy-from", help="Profil source à copier (pour 'new')")
    p_prof.add_argument("--file", help="Fichier JSON cible ou source (pour 'export'/'import')")

    # daemon
    p_daemon = subparsers.add_parser("daemon", parents=[common_parser], help="Lancer le démon de bascule automatique de profils")

    args = parser.parse_args()

    if not args.command:
        # Default to status if no command given
        args.command = "status"

    driver = SkillkorpK20Driver(dev_path=args.device)

    dispatch = {
        "status": cmd_status,
        "battery": cmd_battery,
        "rgb": cmd_rgb,
        "side-rgb": cmd_side_rgb,
        "polling-rate": cmd_polling_rate,
        "debounce": cmd_debounce,
        "sleep": cmd_sleep,
        "win-lock": cmd_win_lock,
        "wasd-swap": cmd_wasd_swap,
        "os-mode": cmd_os_mode,
        "gaming-mode": cmd_gaming_mode,
        "remap": cmd_remap,
        "reset": cmd_reset,
        "profile": cmd_profile,
        "daemon": cmd_daemon,
    }

    fn = dispatch.get(args.command)
    if fn:
        fn(driver, args)


if __name__ == "__main__":
    main()
